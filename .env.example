# --- Neo4j ---------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123

# --- LLM -----------------------------------------------------------------
# N'importe quelle API compatible OpenAI : Mistral, OpenAI, vLLM local,
# une gateway interne... Seule l'URL et le nom du modele changent.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
LLM_API_KEY=

# --- Embeddings ----------------------------------------------------------
# Modele local, telecharge au premier lancement (~450 Mo).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMS=384
